# Copy to .env.local for local use. Never commit real values.

# --- AI provider ------------------------------------------------------------
# Which AI runs the agent: openai (default) | anthropic | gemini | ollama
LLM_PROVIDER=openai
# OpenAI API key (platform.openai.com/api-keys) – set a spend limit on the account
OPENAI_API_KEY=
# OpenAI model name used for all three AI steps
OPENAI_MODEL=gpt-5-mini
# Thinking effort for reasoning models (gpt-5*, o*): minimal | low | medium | high (default low; ignored for other models)
OPENAI_REASONING_EFFORT=low

# Optional: only needed if LLM_PROVIDER is anthropic / gemini / ollama
# Claude API key
ANTHROPIC_API_KEY=
# Claude model name
ANTHROPIC_MODEL=claude-haiku-5-5
# Gemini API key (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Gemini model name
GEMINI_MODEL=gemini-3.8-flash
# Ollama server URL (local model on your laptop)
OLLAMA_URL=http://localhost:11434
# Ollama model name
OLLAMA_MODEL=qwen3:8b
# Optional: other API base URL for an OpenAI-compatible server (default https://api.openai.com/v1)
# OPENAI_BASE_URL=
# Optional: other API base URL for Gemini (default https://generativelanguage.googleapis.com)
# GEMINI_BASE_URL=

# --- Live inbox ---------------------------------------------------------------
# "true" = incoming emails are processed by the AI; anything else = only stored with "Live-Modus aus"
ENABLE_LIVE=false
# Secret in the webhook URL (/api/inbound-email?token=...); same value goes into WEBHOOK_URL of GmailForwarder.gs
INBOUND_WEBHOOK_TOKEN=
# Demo Gmail address shown on the page ("Schreiben Sie eine E-Mail an ...")
INBOUND_EMAIL_ADDRESS=
# Max live tickets processed per day, all senders together (default 60)
LIVE_DAILY_LIMIT=60
# Max live tickets processed per sender per hour (default 5)
LIVE_PER_SENDER_HOUR=5
# Optional: characters kept from a message, the rest is cut off (default 2000)
# LIVE_BODY_MAX_CHARS=2000

# --- Google Sheet storage (apps-script/Code.gs) ------------------------------
# Web app URL of the Code.gs deployment (ends with /exec). Empty = in-memory store (local testing)
SHEET_API_URL=
# Same value as the script property SECRET in Code.gs
SHEET_API_SECRET=
# Optional: "anyone with the link can view" link to the Sheet, shown on the page
SHEET_PUBLIC_URL=

# --- Page ---------------------------------------------------------------------
# Optional: link to the GitHub repo, shown on the page
GITHUB_URL=
